{
  "name": "@hyper-light/vorpal-cli",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Search and Rewrite code at large scale using precise AST pattern",
  "homepage": "https://vorpal.github.io",
  "repository": "https://github.com/hyper-light/vorpal",
  "license": "MIT",
  "engines": {
    "node": ">= 12.0.0"
  },
  "keywords": [
    "ast",
