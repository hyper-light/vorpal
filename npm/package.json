  },
  "scripts": {
    "postinstall": "node postinstall.js"
  },
  "optionalDependencies": {
    "@hyper-light/vorpal-cli-win32-arm64-msvc": "0.2.0",
    "@hyper-light/vorpal-cli-win32-ia32-msvc": "0.2.0",
    "@hyper-light/vorpal-cli-win32-x64-msvc": "0.2.0",
    "@hyper-light/vorpal-cli-darwin-arm64": "0.2.0",
    "@hyper-light/vorpal-cli-linux-arm64-gnu": "0.2.0",
    "@hyper-light/vorpal-cli-linux-x64-gnu": "0.2.0",
    "@hyper-light/vorpal-cli-linux-arm64-musl": "0.2.0",
    "@hyper-light/vorpal-cli-linux-x64-musl": "0.2.0"
