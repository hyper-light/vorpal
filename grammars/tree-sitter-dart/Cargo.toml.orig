[package]
name = "tree-sitter-dart"
description = "Dart grammar for tree-sitter"
version = "0.2.0"
authors = ["Kasper Overgård Nielsen <kasper@byolimit.com>"]
license = "MIT"
readme = "README.md"
keywords = ["incremental", "parsing", "tree-sitter", "dart"]
categories = ["parser-implementations", "parsing", "text-editors"]
repository = "https://github.com/nielsenko/tree-sitter-dart"
edition = "2021"
autoexamples = false

build = "bindings/rust/build.rs"
include = [
  "/Cargo.toml",
  "/LICENSE",
  "/README.md",
  "/bindings/rust/**",
  "/grammar.js",
  "/queries/**",
  "/src/**",
  "/tree-sitter.json",
]

[lib]
path = "bindings/rust/lib.rs"

[dependencies]
tree-sitter-language = "0.1"

[build-dependencies]
cc = "1.2"

[dev-dependencies]
tree-sitter = "0.26"
